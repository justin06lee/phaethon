# The hollow and bangboo a release of phaethon carries, as tags. The release
# workflow reads this, so each is cloned at its tag rather than taken from a
# checkout; a plain `make` ignores it. To build a release locally:
#
#   env $(grep -v '^#' versions.env) make dist
#
# bangboo's go.mod names the hollow it is built against; keep HOLLOW_REF the
# same, so the hollow phaethon puts on hosts is the one bangboo expects.
HOLLOW_REF=v0.3.0
BANGBOO_REF=v0.4.0
